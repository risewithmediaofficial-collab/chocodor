# ===================================================
# Choco D'or Backend Environment Template (.env.example)
# ===================================================

PORT=5008
NODE_ENV=development
CLIENT_URL=http://localhost:5176

JWT_SECRET=your_jwt_secret_key_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

MONGODB_URI=mongodb://localhost:27017/chocodor

RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# ── Pine Labs Plutus Cloud Integration ──────────────────────────────────────
# Get these from your Pine Labs merchant dashboard or Pine Labs support.
# PINELABS_ENV: UAT (testing) or PRODUCTION
PINELABS_ENV=PRODUCTION
PINELABS_CLIENT_ID=your_pine_labs_client_id
PINELABS_USER_ID=your_pine_labs_user_id
PINELABS_SECURITY_TOKEN=your_pine_labs_security_token
PINELABS_MERCHANT_ID=your_pine_labs_merchant_id
# AllowedPaymentMode: 37 = All Cards, 1 = Credit Only, 2 = Debit Only
PINELABS_ALLOWED_PAYMENT_MODE=37
# Set PINELABS_MOCK=true to test the UI without a real Pine Labs terminal
PINELABS_MOCK=false

STORE_NAME=Choco D'or Confectionery
STORE_PHONE=+91 94880 54036
STORE_EMAIL=contact@chocodor.com
STORE_ADDRESS=Royakottai flyover, near SBI Bank, Londenpet, Krishnagiri, Bayanapalli, Tamil Nadu 635001
STORE_FSSAI=22418107000384
STORE_GST=33ADEPA2229C2ZG
